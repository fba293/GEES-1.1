# GEES Production Apache / cPanel configuration
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route /api/track-visa to /api/track-visa.php
  RewriteRule ^api/track-visa/?$ api/track-visa.php [L,QSA]

  # Route /track-visa to /track-visa.html
  RewriteRule ^track-visa/?$ track-visa.html [L]

  # Route clean service and destination URLs (e.g. /school-admission to school-admission.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
